<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="app.swis.prepair.run">
    <description>Pair a Switch 2 with your phone's Bluetooth address</description>
    <message>SWIS Pre-pair needs your password to change the Bluetooth adapter for a minute.</message>
    <icon_name>swis-prepair</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/swis-prepair/swis_prepair.py</annotate>
  </action>
</policyconfig>
